{
  "name": "scorecard-pipeline-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SPA de revisão de scorecards de entrevistas do projeto scorecard-pipeline",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:a11y": "node scripts/audit-a11y.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "build:demo-reference": "node scripts/build-demo-reference.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
